    "version": "0.2.0",
    "configurations": [
        {
            "name": "Default Game",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/bin/sh2d.exe",
            "args": ["data"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/bin/",
            "environment": [],
            "console": "newExternalWindow"
        },
        {
            "name": "Space Game",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/bin/sh2d.exe",
            "args": ["../demos/space"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/bin/",
            "environment": [],
            "console": "newExternalWindow"
        },
    ]
}